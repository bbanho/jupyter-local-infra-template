   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Phase 3: Extract Holographic Keys\n",
    "\n",
    "Mean-pooled last hidden state of each shard's representative samples."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === PHASE 3: EXTRACT HOLOGRAPHIC KEYS ===\n",
    "import torch\n",
    "import numpy as np\n",
    "from transformers import AutoModelForCausalLM, AutoTokenizer\n",
    "from peft import PeftModel\n",
    "\n",
    "def extract_holographic_key(model, tokenizer, shard_chunks, max_samples=32, max_length=512):\n",
    "    \"\"\"Mean-pooled last hidden state of shard's representative samples.\"\"\"\n",
    "    model.eval()\n",
    "    keys = []\n",
    "    for chunk in shard_chunks[:max_samples]:\n",
    "        text = chunk.get(\"text\", \"\") or chunk.get(\"content\", \"\")\n",
    "        if not text.strip():\n",
    "            continue\n",
    "        inputs = tokenizer(text, return_tensors=\"pt\", truncation=True, max_length=max_length).to(model.device)\n",
    "        with torch.no_grad():\n",
    "            outputs = model(**inputs, output_hidden_states=True)\n",
    "            # Last layer, mean pool over sequence\n",
    "            key = outputs.hidden_states[-1].mean(dim=1).squeeze().cpu().numpy()\n",
    "            keys.append(key)\n",
    "    if not keys:\n",
    "        return np.zeros(model.config.hidden_size)\n",
    "    return np.mean(keys, axis=0)\n",
    "\n",
    "# Load base model once\n",
    "print(\"Loading base model for key extraction...\")\n",
    "base_model = AutoModelForCausalLM.from_pretrained(\n",
    "    CONFIG[\"base_model\"],\n",
    "    device_map=\"auto\",\n",
    "    torch_dtype=torch.bfloat16 if CONFIG[\"bf16\"] else torch.float16,\n",
    "    trust_remote_code=True,\n",
    ")\n",
    "tokenizer = AutoTokenizer.from_pretrained(CONFIG[\"base_model\"], trust_remote_code=True)\n",
    "tokenizer.pad_token = tokenizer.eos_token\n",
    "\n",
    "shard_keys = []\n",
    "for shard_id in range(CONFIG[\"n_shards\"]):\n",
    "    data_path = os.path.join(CONFIG[\"data_dir\"], f\"shard_{shard_id}.jsonl\")\n",
    "    if not os.path.exists(data_path):\n",
    "        print(f\"  Shard {shard_id}: data not found, skipping\")\n",
    "        shard_keys.append(np.zeros(base_model.config.hidden_size))\n",
    "        continue\n",
    "    \n",
    "    # Load adapter\n",
    "    adapter_path = os.path.join(CONFIG[\"models_dir\"], f\"lora-shard-{shard_id:02d}\")\n",
    "    if not os.path.exists(adapter_path):\n",
    "        print(f\"  Shard {shard_id}: adapter not found, skipping\")\n",
    "        shard_keys.append(np.zeros(base_model.config.hidden_size))\n",
    "        continue\n",
    "    \n",
    "    model = PeftModel.from_pretrained(base_model, adapter_path)\n",
    "    \n",
    "    # Load sample chunks\n",
    "    chunks = []\n",
    "    with open(data_path, \"r\") as f:\n",
    "        for line in f:\n",
    "            chunks.append(json.loads(line))\n",
    "    \n",
    "    key = extract_holographic_key(model, tokenizer, chunks)\n",
    "    shard_keys.append(key)\n",
    "    print(f\"  Shard {shard_id}: key shape {key.shape}, norm={np.linalg.norm(key):.4f}\")\n",
    "    \n",
    "    # Unload adapter to save VRAM\n",
    "    del model\n",
    "    torch.cuda.empty_cache()\n",
    "\n",
    "shard_keys = np.array(shard_keys)  # [n_shards, hidden_size]\n",
    "np.save(CONFIG[\"shard_keys_path\"], shard_keys)\n",
    "print(f\"\\n✅ Saved shard keys: {CONFIG['shard_keys_path']} — shape {shard_keys.shape}\")"
   ]
