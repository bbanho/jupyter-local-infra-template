    "# === PHASE 6: EVALUATION ===\n",
    "import time\n",
    "\n",
    "def evaluate_mole(query, mole_inference, ground_truth=None):\n",
    "    \"\"\"Evaluate MoLE on a single query.\"\"\"\n",
    "    start = time.time()\n",
    "    response = mole_inference(query)\n",
    "    latency = time.time() - start\n",
    "    \n",
    "    result = {\n",
    "        \"query\": query,\n",
    "        \"response\": response,\n",
    "        \"latency\": latency,\n",
    "        \"tokens_per_sec\": len(response.split()) / latency if latency > 0 else 0\n",
    "    }\n",
    "    \n",
    "    if ground_truth:\n",
    "        # Add your metrics: recall, drift, quality\n",
    "        result[\"ground_truth\"] = ground_truth\n",
    "    \n",
    "    return result\n",
    "\n",
    "# Example usage (after implementing MoLEInference class):\n",
    "# mole = MoLEInference(...)\n",
    "# test_queries = [\"How does AuthGuard work?\", \"Explain PPR in NEXUS\", ...]\n",
    "# results = [evaluate_mole(q, mole) for q in test_queries]\n",
    "# print(f\"Avg latency: {np.mean([r['latency'] for r in results]):.2f}s\")\n",
    "# print(f\"Avg tokens/s: {np.mean([r['tokens_per_sec'] for r in results]):.1f}\")\n",
