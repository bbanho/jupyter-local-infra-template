   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Phase 5: Aggregator Training\n",
    "\n",
    "Cross-attention fusion of top-k shard outputs."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === PHASE 5: AGGREGATOR TRAINING ===\n",
    "class HolographicAggregator(nn.Module):\n",
    "    def __init__(self, hidden_size=768, n_heads=8):\n",
    "        super().__init__()\n",
    "        self.cross_attn = nn.MultiheadAttention(hidden_size, n_heads, batch_first=True)\n",
    "        self.gate = nn.Linear(hidden_size * 2, hidden_size)\n",
    "        self.norm = nn.LayerNorm(hidden_size)\n",
    "    \n",
    "    def forward(self, query_hidden, shard_outputs, weights):\n",
    "        # query_hidden: [1, seq_len, hidden_size]\n",
    "        # shard_outputs: list of [1, seq_len, hidden_size]\n",
    "        # weights: [n_active]\n",
    "        \n",
    "        # Weighted combination of shard outputs\n",
    "        weighted = sum(w * out for w, out in zip(weights, shard_outputs))\n",
    "        weighted = weighted.unsqueeze(0) if weighted.dim() == 2 else weighted\n",
    "        \n",
    "        # Cross-attention: query attends to weighted shard knowledge\n",
    "        attended, _ = self.cross_attn(query_hidden, weighted, weighted)\n",
    "        \n",
    "        # Gated fusion\n",
    "        fused = self.gate(torch.cat([query_hidden, attended], dim=-1))\n",
    "        return self.norm(fused + query_hidden)\n",
    "\n",
    "aggregator = HolographicAggregator().to(\"cuda\")\n",
    "\n",
    "# Training: reconstruction loss (aggregated output → target tokens)\n",
    "# Requires: (query, target_response) pairs\n",
    "print(\"⚠️  Aggregator training requires (query, target_response) pairs.\")\n",
    "print(\"Use same eval set as router, with expected output text.\")\n",
    "\n",
    "# torch.jit.save(torch.jit.trace(aggregator, (torch.randn(1, 10, 768).cuda(), \n",
    "#                                               [torch.randn(1, 10, 768).cuda()]*3,\n",
    "#                                               torch.tensor([0.5, 0.3, 0.2]).cuda())),\n",
    "#                CONFIG[\"aggregator_path\"])\n",
    "# print(f\"✅ Aggregator saved: {CONFIG['aggregator_path']}\")"
