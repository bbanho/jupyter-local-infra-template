   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Phase 4: Router Training\n",
    "\n",
    "Learned router: query embedding → top-k shard keys (cosine similarity)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === PHASE 4: ROUTER TRAINING ===\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "from torch.optim import AdamW\n",
    "\n",
    "class HolographicRouter(nn.Module):\n",
    "    def __init__(self, n_shards, dim, temperature=1.0):\n",
    "        super().__init__()\n",
    "        self.shard_keys = nn.Parameter(torch.zeros(n_shards, dim))  # Will load from .npy\n",
    "        self.query_proj = nn.Linear(dim, dim)\n",
    "        self.temperature = nn.Parameter(torch.tensor(temperature))\n",
    "    \n",
    "    def forward(self, query_emb, top_k=3):\n",
    "        # query_emb: [dim] or [B, dim]\n",
    "        if query_emb.dim() == 1:\n",
    "            query_emb = query_emb.unsqueeze(0)\n",
    "        q = self.query_proj(query_emb)  # [B, dim]\n",
    "        scores = (q @ self.shard_keys.T) / self.temperature  # [B, n_shards]\n",
    "        topk_scores, topk_indices = scores.topk(top_k, dim=-1)\n",
    "        weights = F.softmax(topk_scores, dim=-1)\n",
    "        return topk_indices, weights\n",
    "\n",
    "# Load shard keys\n",
    "shard_keys = np.load(CONFIG[\"shard_keys_path\"])\n",
    "n_shards, dim = shard_keys.shape\n",
    "\n",
    "router = HolographicRouter(n_shards, dim).to(\"cuda\")\n",
    "router.shard_keys.data = torch.from_numpy(shard_keys).float().to(\"cuda\")\n",
    "\n",
    "# Training data: (query, target_shard_id) pairs\n",
    "# TODO: Generate from your evaluation set\n",
    "print(\"⚠️  Router training requires labeled (query, relevant_shard) pairs.\")\n",
    "print(\"Generate these from your test queries + human labels or LLM-as-judge.\")\n",
    "\n",
    "# Example training loop (adapt):\n",
    "# optimizer = AdamW(router.parameters(), lr=1e-3)\n",
    "# for epoch in range(10):\n",
    "#     for query_emb, target_shard in train_pairs:\n",
    "#         indices, weights = router(query_emb)\n",
    "#         # Loss: encourage target_shard in top-k with high weight\n",
    "#         target_mask = (indices == target_shard).float()\n",
    "#         loss = -(target_mask * weights.log()).sum()\n",
    "#         loss.backward()\n",
    "#         optimizer.step()\n",
    "#         optimizer.zero_grad()\n",
    "\n",
    "# torch.jit.save(torch.jit.trace(router, torch.randn(1, dim).cuda()), CONFIG[\"router_path\"])\n",
    "# print(f\"✅ Router saved: {CONFIG['router_path']}\")"
   ]
  },
