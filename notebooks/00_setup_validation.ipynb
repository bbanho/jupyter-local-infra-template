   "source": [
    "# Environment Validation — Jupyter Local Infra\n",
    "# Run this first to verify GPU, Docker volumes, and service connectivity\n",
    "\n",
    "import sys\n",
    "import subprocess\n",
    "import json\n",
    "\n",
    "print(\"=== Python Environment ===\")\n",
    "print(f\"Python: {sys.version}\")\n",
    "print(f\"Executable: {sys.executable}\")\n",
    "\n",
    "print(\"\\n=== PyTorch / CUDA ===\")\n",
    "try:\n",
    "    import torch\n",
    "    print(f\"PyTorch: {torch.__version__}\")\n",
    "    print(f\"CUDA available: {torch.cuda.is_available()}\")\n",
    "    if torch.cuda.is_available():\n",
    "        print(f\"CUDA version: {torch.version.cuda}\")\n",
    "        print(f\"GPU count: {torch.cuda.device_count()}\")\n",
    "        for i in range(torch.cuda.device_count()):\n",
    "            print(f\"  GPU {i}: {torch.cuda.get_device_name(i)}\")\n",
    "            print(f\"    Memory: {torch.cuda.get_device_properties(i).total_memory / 1e9:.1f} GB\")\n",
    "except ImportError:\n",
    "    print(\"PyTorch not installed\")\n",
    "\n",
    "print(\"\\n=== Key ML Libraries ===\")\n",
    "for lib in [\"transformers\", \"peft\", \"bitsandbytes\", \"sentence_transformers\", \"faiss\", \"networkx\", \"pandas\", \"sklearn\"]:\n",
    "    try:\n",
    "        mod = __import__(lib)\n",
    "        version = getattr(mod, \"__version__\", \"unknown\")\n",
    "        print(f\"  {lib}: {version}\")\n",
    "    except ImportError:\n",
    "    \n",
    "    print(f\"  {lib}: NOT INSTALLED\")\n",
    "\n",
    "print(\"\\n=== Ollama Connection ===\")\n",
    "try:\n",
    "    import httpx\n",
    "    resp = httpx.get(\"http://localhost:11434/api/tags\", timeout=5.0)\n",
    "    if resp.status_code == 200:\n",
    "        models = resp.json().get(\"models\", [])\n",
    "        print(f\"Ollama reachable: YES ({len(models)} models)\")\n",
    "        for m in models[:5]:\n",
    "            print(f\"  - {m.get('name', 'unknown')}\")\n",
    "    else:\n",
    "        print(f\"Ollama responded: {resp.status_code}\")\n",
    "except Exception as e:\n",
    "    print(f\"Ollama connection failed: {e}\")\n",
    "\n",
    "print(\"\\n=== MCP Proxy Connection ===\")\n",
    "try:\n",
    "    resp = httpx.get(\"http://localhost:7475/health\", timeout=5.0)\n",
    "    if resp.status_code == 200:\n",
    "        print(f\"MCP Proxy reachable: YES\")\n",
    "        print(f\"  Response: {resp.json()}\")\n",
    "    else:\n",
    "        print(f\"MCP Proxy responded: {resp.status_code}\")\n",
    "except Exception as e:\n",
    "    print(f\"MCP Proxy connection failed: {e}\")\n",
    "\n",
    "print(\"\\n=== Docker Volumes (from container perspective) ===\")\n",
    "import os\n",
    "for path in [\"/home/jovyan/work/notebooks\", \"/home/jovyan/work/data\", \"/home/jovyan/work/models\", \"/home/jovyan/work/cache\"]:\n",
    "    exists = os.path.exists(path)\n",
    "    writable = os.access(path, os.W_OK) if exists else False\n",
    "    print(f\"  {path}: exists={exists}, writable={writable}\")\n",
    "\n",
    "print(\"\\n✅ Validation complete\")\n",
    "print(\"If all checks pass, your environment is ready for MoLE development.\")\n",
    "print(\"Next: Open 02_mole_holographic.ipynb for the MoLE pipeline.\")\n",
   ]
  }
