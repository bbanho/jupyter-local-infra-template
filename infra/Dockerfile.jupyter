# =============================================================================
# DOCKERFILE.JUPYTER — NEXUS Studies Environment
# =============================================================================
# Pre-installs: PyTorch CUDA 12.4, transformers, peft, bitsandbytes, flash-attn,
#               sentence-transformers (nomic-embed), networkx, pandas, etc.
# Build: docker build -f infra/Dockerfile.jupyter -t nexus-jupyter:local .
# =============================================================================

ARG BASE_IMAGE=nvidia/cuda:12.4.1-devel-ubuntu22.04
ARG PYTHON_VERSION=3.11

FROM ${BASE_IMAGE} AS base

# -----------------------------------------------------------------------------
# System dependencies
# -----------------------------------------------------------------------------
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python${PYTHON_VERSION} python${PYTHON_VERSION}-dev python${PYTHON_VERSION}-venv \
    python3-pip python3-wheel \
    git curl wget ca-certificates \
    build-essential cmake ninja-build \
    libopenblas-dev libomp-dev \
    libjpeg-dev libpng-dev libtiff-dev \
    && rm -rf /var/lib/apt/lists/*

# Python symlinks
RUN update-alternatives --install /usr/bin/python python /usr/bin/python${PYTHON_VERSION} 1 \
    && update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1

# -----------------------------------------------------------------------------
# UV (fast Python package installer) - install early for caching
# -----------------------------------------------------------------------------
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

# -----------------------------------------------------------------------------
# Python dependencies — split into layers for caching
# -----------------------------------------------------------------------------
WORKDIR /app

# Layer 1: Core ML stack (PyTorch CUDA 12.4)
# Uses --index-url for faster CUDA wheels
RUN uv pip install --system --no-cache \
    --index-url https://download.pytorch.org/whl/cu124 \
    torch==2.4.1 torchvision==0.19.1 torchaudio==2.4.1

# Layer 2: Transformers ecosystem (peft, bitsandbytes, accelerate)
RUN uv pip install --system --no-cache \
    transformers==4.44.2 \
    peft==0.12.0 \
    accelerate==0.33.0 \
    bitsandbytes==0.44.0 \
    triton==3.1.0

# Layer 3: Flash Attention 2 (requires CUDA 11.8+)
# Build from source for CUDA 12.4 compatibility
RUN uv pip install --system --no-cache \
    flash-attn==2.6.3 --no-build-isolation

# Layer 4: Embeddings & Vector Search
RUN uv pip install --system --no-cache \
    sentence-transformers==3.1.0 \
    faiss-gpu==1.8.0 \
    hnswlib==0.8.0

# Layer 5: Graph & Data Science
RUN uv pip install --system --no-cache \
    networkx==3.3 \
    pandas==2.2.2 \
    numpy==1.26.4 \
    scipy==1.13.1 \
    scikit-learn==1.5.1 \
    matplotlib==3.9.2 \
    seaborn==0.13.2 \
    plotly==5.23.0

# Layer 6: Jupyter & Development Tools
RUN uv pip install --system --no-cache \
    jupyterlab==4.2.5 \
    ipywidgets==8.1.3 \
    jupyter-server-proxy==4.1.0 \
    jupyterlab-git==0.50.0 \
    nbformat==5.10.4 \
    nbconvert==7.16.4 \
    ipykernel==6.29.5

# Layer 7: MCP & API Clients
RUN uv pip install --system --no-cache \
    mcp==1.2.0 \
    fastapi==0.112.2 \
    uvicorn==0.30.5 \
    httpx==0.27.2 \
    websockets==13.1

# Layer 8: Database & NEXUS-specific
RUN uv pip install --system --no-cache \
    psycopg2-binary==2.9.9 \
    asyncpg==0.29.0 \
    sqlalchemy==2.0.32 \
    redis==5.0.8

# Layer 9: Utilities & Quality of Life
RUN uv pip install --system --no-cache \
    rich==13.9.4 \
    typer==0.12.5 \
    pyyaml==6.0.1 \
    python-dotenv==1.0.1 \
    tqdm==4.66.5 \
    orjson==3.10.11 \
    msgpack==1.1.0

# -----------------------------------------------------------------------------
# Jupyter Configuration
# -----------------------------------------------------------------------------
RUN mkdir -p /home/jovyan/.jupyter /home/jovyan/work
COPY infra/jupyter_notebook_config.py /home/jovyan/.jupyter/jupyter_notebook_config.py
RUN chown -R 1000:1000 /home/jovyan

# -----------------------------------------------------------------------------
# Ollama Model Pre-pull (runs at container start via entrypoint)
# -----------------------------------------------------------------------------
COPY infra/pull_models.sh /usr/local/bin/pull_models.sh
RUN chmod +x /usr/local/bin/pull_models.sh

# -----------------------------------------------------------------------------
# Entrypoint
# -----------------------------------------------------------------------------
COPY infra/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER 1000
WORKDIR /home/jovyan/work

EXPOSE 8888 8765

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root", "--NotebookApp.token=nexus-study", "--NotebookApp.allow_origin=https://colab.research.google.com", "--ServerApp.root_dir=/home/jovyan/work"]

# =============================================================================
# BUILD ARGS FOR CUSTOMIZATION
# =============================================================================
# BASE_IMAGE: nvidia/cuda:12.4.1-devel-ubuntu22.04 (default)
#             nvidia/cuda:12.1.1-devel-ubuntu22.04 (older CUDA)
# PYTHON_VERSION: 3.11 (default), 3.10, 3.12
# 
# To rebuild with different CUDA:
#   docker build --build-arg BASE_IMAGE=nvidia/cuda:12.1.1-devel-ubuntu22.04 -f infra/Dockerfile.jupyter -t nexus-jupyter:local .
# =============================================================================